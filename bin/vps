#!/usr/bin/env node
'use strict';

// vps - public https/tcp links for ports on your own server.
// No agent, no account, no tunnel: DNS points at your box, a reverse proxy
// on the box does the work. The command holds the route open until you ctrl-c.

const { spawn, spawnSync } = require('node:child_process');
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const readline = require('node:readline');

const VERSION = '0.1.0';
const CONFIG_PATH = path.join(os.homedir(), '.config/vps/config.json');
const STATE_FILE = '/etc/vps/routes.json';
const STATE_EMPTY = { version: 1, http: [], tcp: [] };

let cfg = null;
const active = [];
let shuttingDown = false;

// ---------- small helpers ----------

function readJson(p) {
  try { return JSON.parse(fs.readFileSync(p, 'utf8')); } catch { return null; }
}

function die(msg) {
  process.stderr.write('error: ' + msg + '\n');
  process.exit(1);
}

function sleep(ms) {
  Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);
}

function keepAlive() {
  setInterval(() => {}, 1 << 30);
}

function writeLine(s = '') {
  process.stdout.write(s + '\n');
}

// ---------- config ----------

function config() {
  if (cfg) return cfg;
  const c = readJson(CONFIG_PATH);
  if (!c || !c.host) die('not configured yet. run: vps setup --help');
  c.proxy = c.proxy || {};
  c.dns = c.dns || { provider: 'manual' };
  cfg = c;
  return cfg;
}

function saveConfig(c) {
  fs.mkdirSync(path.dirname(CONFIG_PATH), { recursive: true });
  fs.writeFileSync(CONFIG_PATH, JSON.stringify(c, null, 2) + '\n');
}

// ---------- ssh ----------

function sshRun(script, input) {
  config();
  const r = spawnSync(
    'ssh',
    ['-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10', cfg.host, 'bash -s'],
    { input: input === undefined ? script : input, encoding: 'utf8', maxBuffer: 32 * 1024 * 1024 }
  );
  if (r.error) die('ssh: ' + r.error.message);
  if (r.status !== 0) die('remote command failed:\n' + (r.stderr || '').trim());
  return r.stdout;
}

function sshTry(script, host) {
  const r = spawnSync(
    'ssh',
    ['-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10', host || cfg.host, 'bash -s'],
    { input: script, encoding: 'utf8', maxBuffer: 32 * 1024 * 1024 }
  );
  return { ok: r.status === 0, out: r.stdout || '', err: r.stderr || '' };
}

function sshWrite(remotePath, content) {
  config();
  const dir = remotePath.replace(/\/[^/]+$/, '');
  const r = spawnSync(
    'ssh',
    ['-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10', cfg.host, `bash -c 'mkdir -p ${dir} && cat > ${remotePath}'`],
    { input: content, encoding: 'utf8' }
  );
  if (r.status !== 0) die(`could not write ${remotePath}: ${(r.stderr || '').trim()}`);
}

// ---------- state (lives on the server) ----------

function getState() {
  const raw = sshRun(`cat ${STATE_FILE} 2>/dev/null || true`).trim();
  if (!raw) return JSON.parse(JSON.stringify(STATE_EMPTY));
  try {
    const s = JSON.parse(raw);
    s.http = s.http || [];
    s.tcp = s.tcp || [];
    return s;
  } catch {
    die(`state file ${STATE_FILE} is not valid json`);
  }
}

function putState(state) {
  sshWrite(STATE_FILE, JSON.stringify(state, null, 2) + '\n');
}

// ---------- proxy (caddy) ----------

function isHostNetwork() {
  return config().proxy.networkMode === 'host' || cfg.proxy.mode === 'managed';
}

function needsRelay(loopbackOnly) {
  return loopbackOnly && !isHostNetwork();
}

function siteFile() {
  config();
  return path.join(cfg.proxy.sitesDir, 'vps.caddy');
}

function caddyText(state) {
  config();
  const head = [
    '# Generated by the vps CLI. Change routes with `vps http` / `vps rm`, not by hand.',
    `# source of truth: ${STATE_FILE}`,
    '',
  ];
  const blocks = state.http.map((r) => {
    const upstream = isHostNetwork() && !r.relay
      ? `127.0.0.1:${r.port}`
      : `${cfg.publicIp}:${r.upstreamPort}`;
    return [
      `# vps http ${r.port}${r.relay ? ` (relay ${r.upstreamPort})` : ''} -> ${r.name}.${cfg.domain}`,
      `${r.name}.${cfg.domain} {`,
      '\tlog {',
      `\t\toutput file ${cfg.proxy.logPath}/${r.name}.log {`,
      '\t\t\troll_size 10MiB',
      '\t\t\troll_keep 2',
      '\t\t}',
      '\t}',
      `\treverse_proxy ${upstream}`,
      '}',
      '',
    ].join('\n');
  });
  return head.join('\n') + blocks.join('\n');
}

function uploadCaddy(state) {
  sshRun(`mkdir -p ${cfg.proxy.sitesDir} ${cfg.proxy.logDir}`);
  sshWrite(siteFile(), caddyText(state));
}

function caddyValidateAndReload() {
  config();
  const c = cfg.proxy.container;
  const check = sshTry(
    `docker exec ${c} caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile 2>&1`
  );
  if (!check.ok) return { ok: false, out: check.out + check.err };
  const rel = sshTry(
    `docker exec ${c} caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile 2>&1`
  );
  return { ok: rel.ok, out: rel.out + rel.err };
}

function ensureCaddyImport() {
  config();
  if (cfg.proxy.mode === 'managed') return false;
  const marker = `import ${cfg.proxy.sitesPath}`;
  const has = sshRun(`grep -qF '${marker}' ${cfg.proxy.caddyfile} && echo yes || echo no`).trim();
  if (has === 'yes') return false;
  const stamp = new Date().toISOString().replace(/[:.]/g, '-');
  sshRun(
    [
      `cp ${cfg.proxy.caddyfile} ${cfg.proxy.caddyfile}.bak-vps-${stamp}`,
      `printf '\\n# --- managed by the vps CLI ---\\n${marker}\\n' >> ${cfg.proxy.caddyfile}`,
    ].join('\n')
  );
  return true;
}

// ---------- dns ----------

let teamIdCache;

function vercelToken() {
  if (process.env.VERCEL_TOKEN) return process.env.VERCEL_TOKEN;
  const candidates = [
    path.join(os.homedir(), '.local/share/com.vercel.cli/auth.json'),
    path.join(os.homedir(), 'Library/Application Support/com.vercel.cli/auth.json'),
    path.join(os.homedir(), '.vercel/auth.json'),
  ];
  for (const p of candidates) {
    const t = readJson(p);
    if (t && t.token) return t.token;
  }
  die('no Vercel token found. run `vercel login`, or set VERCEL_TOKEN, or use --dns manual');
}

async function teamId() {
  if (teamIdCache !== undefined) return teamIdCache;
  const r = await fetch('https://api.vercel.com/v2/teams?limit=100', {
    headers: { Authorization: 'Bearer ' + vercelToken() },
  });
  const d = await r.json();
  const teams = d.teams || [];
  const t = cfg.dns.team ? teams.find((x) => x.slug === cfg.dns.team || x.id === cfg.dns.team) : teams[0];
  if (!t) die('could not find the Vercel team for this token');
  teamIdCache = t.id;
  return t.id;
}

async function api(method, p, body) {
  const tid = await teamId();
  const url = new URL('https://api.vercel.com' + p);
  if (tid) url.searchParams.set('teamId', tid);
  const r = await fetch(url, {
    method,
    headers: {
      Authorization: 'Bearer ' + vercelToken(),
      ...(body ? { 'Content-Type': 'application/json' } : {}),
    },
    body: body ? JSON.stringify(body) : undefined,
  });
  const text = await r.text();
  let json = null;
  try { json = JSON.parse(text); } catch {}
  if (!r.ok) {
    const msg = (json && (json.error?.message || json.message)) || text.slice(0, 200);
    die(`vercel api ${method} ${p}: ${r.status} ${msg}`);
  }
  return json;
}

async function dnsList() {
  const out = [];
  let until = null;
  for (let i = 0; i < 10; i++) {
    const q = `/v4/domains/${cfg.domain}/records?limit=100` + (until ? `&until=${until}` : '');
    const d = await api('GET', q);
    out.push(...(d.records || []));
    if (!d.pagination || !d.pagination.next) break;
    until = d.pagination.next;
  }
  return out;
}

function dnsIsManual() {
  return config().dns.provider !== 'vercel';
}

async function dnsAdd(name) {
  if (dnsIsManual()) return null;
  return api('POST', `/v2/domains/${cfg.domain}/records`, {
    name,
    type: 'A',
    value: cfg.publicIp,
    ttl: 60,
  });
}

async function dnsRemove(name) {
  if (dnsIsManual()) return 0;
  const records = await dnsList();
  const hits = records.filter((r) => r.name === name && r.type === 'A' && r.value === cfg.publicIp);
  for (const r of hits) await api('DELETE', `/v2/domains/${cfg.domain}/records/${r.id}`);
  return hits.length;
}

// ---------- probes ----------

function probes() {
  return sshRun(`ss -tlnH 2>/dev/null | awk '{print $4}'`)
    .split('\n')
    .map((s) => s.trim())
    .filter(Boolean);
}

function listenAddrs(port) {
  return probes()
    .filter((p) => p.endsWith(':' + port))
    .map((p) => p.slice(0, -(String(port).length + 1)))
    .map((a) => a.replace(/^\[|\]$/g, ''));
}

function bridgeSubnet() {
  config();
  if (!cfg.proxy.bridge) return '';
  return sshRun(
    `docker network inspect ${cfg.proxy.bridge} -f '{{(index .IPAM.Config 0).Subnet}}' 2>/dev/null || true`
  ).trim();
}

async function waitDns(name, ms = 30000) {
  const deadline = Date.now() + ms;
  const fqdn = `${name}.${cfg.domain}`;
  while (Date.now() < deadline) {
    const r = spawnSync('dig', ['+short', '+time=2', '+tries=1', fqdn, 'A', '@1.1.1.1'], {
      encoding: 'utf8',
    });
    const addrs = (r.stdout || '').trim().split('\n').map((s) => s.trim());
    if (addrs.includes(cfg.publicIp)) return true;
    sleep(1000);
  }
  return false;
}

async function probeUrl(name, ms = 40000) {
  const fqdn = `${name}.${cfg.domain}`;
  const deadline = Date.now() + ms;
  let last = 'no response';
  while (Date.now() < deadline) {
    // ask the origin directly, so a stale resolver cache cannot fake a result
    const r = spawnSync(
      'curl',
      [
        '-sS', '-o', '/dev/null', '-w', '%{http_code}', '--max-time', '6',
        '--resolve', `${fqdn}:443:${cfg.publicIp}`,
        `https://${fqdn}/`,
      ],
      { encoding: 'utf8' }
    );
    const code = (r.stdout || '').trim();
    if (/^[1-5]\d\d$/.test(code)) return { ok: true, status: Number(code) };
    last = ((r.stderr || '').trim().split('\n').pop() || 'tls not ready').replace(/^curl: /, '');
    sleep(1500);
  }
  return { ok: false, error: last };
}

// ---------- systemd forwarders ----------

function unitPair(name, listenPort, targetPort, desc) {
  const sock = [
    '[Unit]',
    `Description=${desc}`,
    '',
    '[Socket]',
    `ListenStream=0.0.0.0:${listenPort}`,
    'Accept=no',
    '',
    '[Install]',
    'WantedBy=sockets.target',
    '',
  ].join('\n');
  const svc = [
    '[Unit]',
    `Description=${desc}`,
    `Requires=vps-${name}.socket`,
    `After=vps-${name}.socket`,
    '',
    '[Service]',
    `ExecStart=/lib/systemd/systemd-socket-proxyd 127.0.0.1:${targetPort}`,
    'PrivateTmp=true',
    '',
  ].join('\n');
  return [
    `cat > /etc/systemd/system/vps-${name}.socket <<'VPSEOF'\n${sock}VPSEOF`,
    `cat > /etc/systemd/system/vps-${name}.service <<'VPSEOF'\n${svc}VPSEOF`,
    'systemctl daemon-reload',
    `systemctl enable --now vps-${name}.socket >/dev/null`,
    `systemctl restart vps-${name}.socket`,
  ].join('\n');
}

function removeUnit(name) {
  return [
    `systemctl disable --now vps-${name}.socket >/dev/null 2>&1 || true`,
    `rm -f /etc/systemd/system/vps-${name}.socket /etc/systemd/system/vps-${name}.service`,
    'systemctl daemon-reload',
  ].join('\n');
}

// ---------- teardown ----------

async function removeHttp(route, { announce = true } = {}) {
  const state = getState();
  state.http = state.http.filter((r) => r.name !== route.name);
  putState(state);
  uploadCaddy(state);
  const reload = caddyValidateAndReload();
  if (!reload.ok) process.stderr.write('warning: caddy reload failed\n' + reload.out + '\n');
  if (route.ufwRule) sshRun(`ufw delete allow ${route.ufwRule} >/dev/null 2>&1 || true`);
  if (route.relay) sshRun(removeUnit(`http-${route.name}`));
  sshRun(`rm -f ${cfg.proxy.logDir}/${route.name}.log`);
  await dnsRemove(route.name);
  if (announce) writeLine(`closed https://${route.name}.${cfg.domain}`);
}

function removeTcp(route, { announce = true } = {}) {
  const state = getState();
  state.tcp = state.tcp.filter((r) => r.publicPort !== route.publicPort);
  putState(state);
  sshRun(removeUnit(`tcp-${route.publicPort}`));
  sshRun(`ufw delete allow ${route.publicPort}/tcp >/dev/null 2>&1 || true`);
  if (announce) writeLine(`closed tcp://${cfg.publicIp}:${route.publicPort}`);
}

async function shutdown() {
  if (shuttingDown) process.exit(130);
  shuttingDown = true;
  writeLine('');
  for (const a of active.splice(0)) {
    try {
      if (a.kind === 'http') await removeHttp(a.route);
      else removeTcp(a.route);
    } catch (e) {
      process.stderr.write('cleanup failed: ' + e.message + '\n');
    }
  }
  process.exit(0);
}

process.on('SIGINT', shutdown);
process.on('SIGTERM', shutdown);
process.on('SIGHUP', shutdown);

// ---------- setup ----------

function sshCheck(host) {
  return sshTry('true', host).ok;
}

function detectIp(host) {
  const r = sshTry(`curl -s --max-time 5 -4 ifconfig.me || true`, host);
  const ip = (r.out || '').trim();
  return /^\d+\.\d+\.\d+\.\d+$/.test(ip) ? ip : '';
}

function inspectExistingProxy(host, container) {
  const r = sshTry(
    [
      `docker inspect ${container} --format '{{json .Mounts}}' 2>/dev/null || echo nope`,
      `docker inspect ${container} --format '{{.HostConfig.NetworkMode}}' 2>/dev/null || echo nope`,
      `docker inspect ${container} --format '{{.State.Status}}' 2>/dev/null || echo nope`,
    ].join("; printf '\\n---\\n'\n"),
    host
  );
  const [mountsJson, netMode, status] = r.out.split('\n---\n').map((s) => s.trim());
  if (!mountsJson || mountsJson === 'nope' || mountsJson.startsWith('nope')) {
    die(`container ${container} not found on ${host}`);
  }
  const mounts = JSON.parse(mountsJson);

  const byDest = (d) => mounts.find((m) => m.Destination === d);
  const caddyFileMount = byDest('/etc/caddy/Caddyfile');
  if (!caddyFileMount) {
    die(`${container} does not mount a Caddyfile at /etc/caddy/Caddyfile, so it is not a caddy container`);
  }

  const rwMounts = mounts.filter((m) => m.RW && m.Type === 'bind');
  const configMount = byDest('/config') || byDest('/etc/caddy') || rwMounts[0];
  if (!configMount) die(`${container} has no writable bind mount for route files`);

  const logMount = byDest('/var/log/caddy');
  const sitesDir = path.join(configMount.Source, 'sites');
  const logDir = logMount ? logMount.Source : path.join(configMount.Source, 'logs');
  const logPath = logMount ? logMount.Destination : `${configMount.Destination}/logs`;

  return {
    mode: 'existing',
    container,
    status,
    networkMode: netMode || 'bridge',
    bridge: netMode && netMode !== 'host' && netMode !== 'default' ? netMode : netMode === 'default' ? 'bridge' : '',
    caddyfile: caddyFileMount.Source,
    sitesDir,
    sitesPath: `${configMount.Destination}/sites/vps.caddy`,
    logDir,
    logPath,
  };
}

function setupManagedProxy(host, dir, container) {
  const docker = sshTry('command -v docker', host).ok;
  if (!docker) {
    die('docker is not installed on the server. install it first:\n  curl -fsSL https://get.docker.com | sh');
  }
  writeLine(`[1/3] writing caddy config to ${dir}`);
  sshRun(
    [
      `mkdir -p ${dir} ${dir}/data ${dir}/logs`,
      `[ -f ${dir}/Caddyfile ] || printf 'import /etc/caddy/sites.caddy\\n' > ${dir}/Caddyfile`,
      `[ -f ${dir}/sites.caddy ] || printf '# routes are generated here by the vps CLI\\n' > ${dir}/sites.caddy`,
    ].join('\n')
  );

  writeLine(`[2/3] starting container ${container}`);
  const exists = sshTry(`docker inspect ${container} >/dev/null 2>&1`, host).ok;
  if (exists) {
    sshRun(`docker start ${container} >/dev/null 2>&1 || true`);
  } else {
    const run = sshTry(
      [
        `docker run -d --name ${container} --network host --restart unless-stopped`,
        `-v ${dir}:/etc/caddy -v ${dir}/data:/data caddy:2`,
      ].join(' '),
      host
    );
    if (!run.ok) die('could not start caddy:\n' + (run.err || run.out).trim());
  }

  writeLine('[3/3] firewall');
  const ufw = sshTry('ufw status 2>/dev/null | head -1', host);
  if ((ufw.out || '').includes('Status: active')) {
    sshRun('ufw allow 80/tcp comment vps-cli >/dev/null; ufw allow 443/tcp comment vps-cli >/dev/null');
    writeLine('      opened 80 and 443 in ufw');
  } else {
    writeLine('      ufw is not active, nothing to open');
  }

  return {
    mode: 'managed',
    container,
    networkMode: 'host',
    caddyfile: `${dir}/Caddyfile`,
    sitesDir: dir,
    sitesPath: '/etc/caddy/sites.caddy',
    logDir: `${dir}/logs`,
    logPath: '/etc/caddy/logs',
  };
}

async function cmdSetup(args) {
  const flags = {};
  const rest = [];
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a === '--host' || a === '-H') flags.host = args[++i];
    else if (a === '--domain' || a === '-D') flags.domain = args[++i];
    else if (a === '--ip') flags.ip = args[++i];
    else if (a === '--dns') flags.dns = args[++i];
    else if (a === '--team') flags.team = args[++i];
    else if (a === '--existing') flags.existing = args[++i];
    else if (a === '--dir') flags.dir = args[++i];
    else if (a === '--container') flags.container = args[++i];
    else if (a === '-h' || a === '--help') flags.help = true;
    else if (a.startsWith('-')) die(`unknown flag ${a}`);
    else rest.push(a);
  }

  if (flags.help || (!flags.host && !rest[0])) {
    writeLine(`usage: vps setup --host <ssh-host> [options]

  --host <h>          ssh target, as in \`ssh <h>\` (required)
  --domain <d>        apex domain, e.g. example.com (needed for https routes)
  --ip <addr>         public ipv4 of the server (detected over ssh by default)
  --dns <p>           vercel | manual   (default: vercel when a token is present)
  --team <slug>       vercel team slug, if the token sees more than one
  --existing <name>   reuse an existing caddy container instead of starting one
  --dir <path>        where the managed caddy lives (default /etc/vps/caddy)
  --container <name>  name for the managed container (default vps-caddy)

managed mode starts its own caddy container on ports 80/443.
existing mode plugs into a caddy container you already run.
manual dns means you add the records yourself, so any dns host works.
`);
    return;
  }

  const host = flags.host || rest[0];
  if (!sshCheck(host)) die(`cannot ssh to "${host}". check your ~/.ssh/config`);

  writeLine(`connected to ${host}`);
  const publicIp = flags.ip || detectIp(host);
  if (!publicIp) die('could not detect the public ipv4. pass --ip');
  writeLine(`public ip: ${publicIp}`);

  const proxy = flags.existing
    ? inspectExistingProxy(host, flags.existing)
    : setupManagedProxy(host, flags.dir || '/etc/vps/caddy', flags.container || 'vps-caddy');
  writeLine(`proxy: ${proxy.mode} (${proxy.container}, ${proxy.networkMode})`);

  let dnsProvider = flags.dns;
  if (!dnsProvider) {
    dnsProvider = vercelTokenExists() ? 'vercel' : 'manual';
  }
  if (dnsProvider === 'vercel' && !flags.domain) {
    die('--dns vercel needs --domain');
  }
  if (dnsProvider === 'vercel') vercelToken(); // fail early if the token is missing

  const next = {
    host,
    domain: flags.domain || '',
    publicIp,
    dns: { provider: dnsProvider, team: flags.team || '' },
    proxy,
  };
  saveConfig(next);
  cfg = next;

  writeLine(`dns: ${dnsProvider}`);
  writeLine(`config: ${CONFIG_PATH}`);

  // wire the import once, so later commands do not have to
  sshRun(`docker exec ${proxy.container} caddy version >/dev/null 2>&1 || true`);
  uploadCaddy(getState());
  const imported = ensureCaddyImport();
  const reload = caddyValidateAndReload();
  if (imported) writeLine('added the import line to the existing caddyfile');
  if (!reload.ok) writeLine('warning: caddy reload failed:\n' + reload.out.trim());

  if (dnsProvider === 'manual' && next.domain) {
    writeLine('');
    writeLine('add this record at your dns host, once:');
    writeLine(`  *.${next.domain}   A   ${publicIp}`);
    writeLine('then every name resolves without another api call.');
  }
  writeLine('');
  writeLine('next: vps http 3000');
}

function vercelTokenExists() {
  if (process.env.VERCEL_TOKEN) return true;
  const candidates = [
    path.join(os.homedir(), '.local/share/com.vercel.cli/auth.json'),
    path.join(os.homedir(), 'Library/Application Support/com.vercel.cli/auth.json'),
    path.join(os.homedir(), '.vercel/auth.json'),
  ];
  return candidates.some((p) => {
    const t = readJson(p);
    return t && t.token;
  });
}

// ---------- routes ----------

function validLabel(n) {
  return /^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$/.test(n) && !n.includes('--');
}

function parseFlags(args) {
  const flags = {};
  const rest = [];
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a === '--as' || a === '--name') flags.as = args[++i];
    else if (a === '--port') flags.port = Number(args[++i]);
    else if (a === '--no-wait') flags.noWait = true;
    else if (a === '-d' || a === '--detach') flags.detach = true;
    else if (a.startsWith('--')) die(`unknown flag ${a}`);
    else rest.push(a);
  }
  return { flags, rest };
}

async function addHttp(port, flags) {
  config();
  if (!cfg.domain) die('no domain configured. run: vps setup --domain example.com');

  const state = getState();
  const name = (flags.as || `p${port}`).toLowerCase();
  if (!validLabel(name)) die(`"${name}" is not a valid dns label`);

  const clash = state.http.find((r) => r.name === name || r.port === port);
  if (clash) die(`${clash.name} already maps port ${clash.port}. close it first: vps rm ${clash.name}`);

  if (!dnsIsManual()) {
    const existing = await dnsList();
    const taken = existing.find((r) => r.name === name && r.type !== 'TXT');
    if (taken) die(`${name}.${cfg.domain} already exists in DNS (${taken.type} ${taken.value})`);
  }

  const addrs = listenAddrs(port);
  const loopbackOnly = addrs.length > 0 && addrs.every((a) => a.startsWith('127.') || a === '::1');
  const notListening = addrs.length === 0;

  let upstreamPort = port;
  let relay = false;
  if (needsRelay(loopbackOnly)) {
    // caddy is in a container, so it cannot reach the host's 127.0.0.1
    const used = new Set(state.http.map((r) => r.upstreamPort));
    const listening = probes();
    let free = null;
    for (let p = 30000; p < 31000; p++) {
      if (used.has(p) || listening.some((x) => x.endsWith(':' + p))) continue;
      free = p;
      break;
    }
    if (!free) die('no free relay port in 30000-30999');
    upstreamPort = free;
    relay = true;
    const started = sshTry(unitPair(`http-${name}`, free, port, `vps http ${port} (${name})`));
    if (!started.ok) {
      sshTry(removeUnit(`http-${name}`));
      die('could not start the relay for the loopback service:\n' + (started.err || started.out).trim());
    }
  }

  let ufwRule = '';
  if (!isHostNetwork()) {
    const subnet = bridgeSubnet();
    if (!subnet) die(`could not read the subnet of docker network ${cfg.proxy.bridge}`);
    ufwRule = `from ${subnet} to any port ${upstreamPort} proto tcp`;
    sshRun(`ufw allow ${ufwRule} comment 'vps-cli' >/dev/null`);
  }

  const route = { name, port, upstreamPort, relay, ufwRule, created: new Date().toISOString() };
  state.http.push(route);
  putState(state);
  uploadCaddy(state);

  const imported = ensureCaddyImport();
  const reload = caddyValidateAndReload();
  if (!reload.ok) {
    state.http = state.http.filter((r) => r.name !== name);
    putState(state);
    uploadCaddy(state);
    if (ufwRule) sshRun(`ufw delete allow ${ufwRule} >/dev/null 2>&1 || true`);
    if (relay) sshRun(removeUnit(`http-${name}`));
    caddyValidateAndReload();
    die('caddy rejected the config:\n' + reload.out.trim());
  }

  active.push({ kind: 'http', route });

  try {
    await dnsAdd(name);
  } catch (e) {
    await removeHttp(route, { announce: false });
    active.pop();
    die(e.message);
  }

  const url = `https://${name}.${cfg.domain}`;
  writeLine(`${url}  ->  ${cfg.host}:${port}${relay ? ` (relayed via :${upstreamPort})` : ''}`);
  if (imported) writeLine(`caddy: import line added to ${cfg.proxy.caddyfile}`);
  if (notListening) {
    writeLine(`note: nothing is listening on ${port} yet on ${cfg.host}`);
    writeLine('note: if it later binds 127.0.0.1 only, restart this command');
  }

  if (!flags.noWait) {
    process.stdout.write('waiting for dns + certificate ');
    const dnsOk = await waitDns(name);
    const r = await probeUrl(name);
    if (r.ok) {
      writeLine(`\nready: ${url} returned ${r.status}`);
    } else {
      writeLine(`\nnot answering yet (${r.error})`);
      if (!dnsOk) {
        writeLine(`dns: ${name}.${cfg.domain} does not resolve to ${cfg.publicIp}`);
        if (dnsIsManual()) writeLine(`add: ${name}.${cfg.domain} A ${cfg.publicIp}  (or *.${cfg.domain})`);
      }
      writeLine(`check the app on ${cfg.host}:${port}`);
    }
  }

  return route;
}

function pickPublicPort(state, target, wanted) {
  if (wanted) {
    if (state.tcp.some((r) => r.publicPort === wanted)) die(`public port ${wanted} is already used by a route`);
    if (probes().some((x) => x.endsWith(':' + wanted))) die(`public port ${wanted} is already in use on ${cfg.host}`);
    if (wanted === target) die('the public port must differ from the target port: the forwarder binds it');
    return wanted;
  }
  const taken = new Set(state.tcp.map((r) => r.publicPort));
  const listening = probes();
  const busy = (p) => taken.has(p) || listening.some((x) => x.endsWith(':' + p));
  const preferred = target <= 9999 ? 20000 + target : null;
  if (preferred && !busy(preferred)) return preferred;
  for (let p = 20000; p < 30000; p++) if (!busy(p)) return p;
  die('no free public tcp port in 20000-29999');
}

async function addTcp(port, flags) {
  const state = getState();
  if (state.tcp.some((r) => r.target === port)) {
    const r = state.tcp.find((x) => x.target === port);
    die(`port ${port} is already published on ${r.publicPort}. close it: vps rm ${r.publicPort}`);
  }

  if (listenAddrs(port).length === 0) writeLine(`note: nothing is listening on ${port} yet`);

  const publicPort = pickPublicPort(state, port, flags.port);

  const started = sshTry(unitPair(`tcp-${publicPort}`, publicPort, port, `vps tcp ${port} -> public ${publicPort}`));
  if (!started.ok) {
    sshTry(removeUnit(`tcp-${publicPort}`));
    die('could not start the tcp forwarder:\n' + (started.err || started.out).trim());
  }
  sshRun(`ufw allow ${publicPort}/tcp comment 'vps-cli' >/dev/null`);

  const route = { target: port, publicPort, created: new Date().toISOString() };
  state.tcp.push(route);
  putState(state);
  active.push({ kind: 'tcp', route });

  writeLine(`tcp://${cfg.publicIp}:${publicPort}  ->  ${cfg.host}:${port}`);
  return route;
}

// ---------- live request log ----------

function tailRequests(name) {
  config();
  const child = spawn(
    'ssh',
    ['-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10', cfg.host,
      `tail -n 0 -F ${cfg.proxy.logDir}/${name}.log 2>/dev/null`],
    { stdio: ['ignore', 'pipe', 'ignore'] }
  );
  const rl = readline.createInterface({ input: child.stdout });
  rl.on('line', (line) => {
    let j;
    try { j = JSON.parse(line); } catch { return; }
    const req = j.request || {};
    const ms = j.duration ? Math.round(j.duration * 1000) : 0;
    const when = new Date(j.ts ? j.ts * 1000 : Date.now()).toISOString().slice(11, 19);
    writeLine(
      `${when}  ${String(j.status || 0).padEnd(3)} ${String(req.method || '-').padEnd(6)} ${ms}ms  ${req.uri || '/'}` +
      `  ${req.remote_ip || ''}`
    );
  });
  child.on('error', () => {});
  return child;
}

// ---------- commands ----------

function usage() {
  writeLine(`vps ${VERSION} - public links for ports on your own server

  vps setup --host <ssh> [--domain <d>]      configure a server (once)
  vps http <port> [--as <name>] [-d]         https://<name>.<domain> -> :<port>
  vps tcp <port> [--port <public>] [-d]      tcp://<ip>:<public> -> :<port>
  vps ls                                     list routes
  vps rm <name|port>                         close a route
  vps clean                                  close routes whose port stopped listening
  vps open <name|port>                       open the https url
  vps doctor                                 check the plumbing

http and tcp stay in the foreground, print requests, and close on ctrl-c.
-d leaves the route up and exits. config: ${CONFIG_PATH}
`);
}

function cmdLs() {
  const state = getState();
  if (!state.http.length && !state.tcp.length) {
    writeLine('no routes');
    return;
  }
  for (const r of state.http) {
    const suffix = r.relay ? ` (relay ${r.upstreamPort})` : '';
    writeLine(`http  https://${r.name}.${cfg.domain}  ->  :${r.port}${suffix}`);
  }
  for (const r of state.tcp) {
    writeLine(`tcp   tcp://${cfg.publicIp}:${r.publicPort}  ->  :${r.target}`);
  }
}

async function cmdRm(args) {
  const key = String(args[0] || '').trim();
  if (!key) die('usage: vps rm <name|port>');
  const state = getState();

  const http = state.http.find((r) => r.name === key || String(r.port) === key);
  const tcp = state.tcp.find((r) => String(r.publicPort) === key || String(r.target) === key);
  if (!http && !tcp) die(`no route matches "${key}"`);

  if (http) await removeHttp(http);
  if (tcp) removeTcp(tcp);
}

async function cmdClean() {
  const state = getState();
  let n = 0;
  for (const r of [...state.http]) {
    if (listenAddrs(r.port).length === 0) {
      await removeHttp(r);
      n++;
    }
  }
  for (const r of [...state.tcp]) {
    if (listenAddrs(r.target).length === 0) {
      removeTcp(r);
      n++;
    }
  }
  writeLine(n ? `closed ${n} stale route(s)` : 'nothing stale');
}

function cmdOpen(args) {
  const key = String(args[0] || '').trim();
  if (!key) die('usage: vps open <name|port>');
  const state = getState();
  const r = state.http.find((x) => x.name === key || String(x.port) === key);
  if (!r) die(`no http route matches "${key}"`);
  const url = `https://${r.name}.${cfg.domain}`;
  spawnSync('open', [url]);
  writeLine(url);
}

async function cmdDoctor() {
  const line = (ok, label, extra = '') =>
    writeLine(`${ok ? 'ok  ' : 'fail'}  ${label}${extra ? '  ' + extra : ''}`);

  const reach = sshTry('true');
  line(reach.ok, `ssh ${cfg.host}`);
  if (!reach.ok) return;

  const info = sshRun(
    [
      `docker inspect ${cfg.proxy.container} --format '{{.State.Status}}' 2>/dev/null || echo missing`,
      `docker network inspect ${cfg.proxy.bridge} -f '{{(index .IPAM.Config 0).Subnet}}' 2>/dev/null || echo none`,
      `curl -s --max-time 5 -4 ifconfig.me || echo none`,
      `test -f ${cfg.proxy.sitesDir}/vps.caddy && echo yes || echo no`,
    ].join("; printf '\\n---\\n'\n")
  ).split('\n---\n').map((s) => s.trim());

  line(info[0] === 'running', `caddy (${cfg.proxy.mode})`, info[0]);
  line(!!cfg.proxy.bridge, 'network', cfg.proxy.networkMode);
  line(info[2] === cfg.publicIp, 'public ip', `${info[2]} (config says ${cfg.publicIp})`);
  line(info[3] === 'yes', 'route file', `${cfg.proxy.sitesDir}/vps.caddy`);

  if (!dnsIsManual()) {
    try {
      const teams = await fetch('https://api.vercel.com/v2/teams?limit=100', {
        headers: { Authorization: 'Bearer ' + vercelToken() },
      });
      line(teams.ok, 'dns api', `vercel ${cfg.dns.team || ''}`.trim());
    } catch {
      line(false, 'dns api');
    }
  } else {
    line(true, 'dns', 'manual, records you add yourself');
  }

  const state = getState();
  line(true, 'routes', `${state.http.length} http, ${state.tcp.length} tcp`);
}

// ---------- main ----------

async function main() {
  const [cmd, ...args] = process.argv.slice(2);

  if (cmd === 'setup') return cmdSetup(args);
  if (cmd === '-v' || cmd === '--version' || cmd === 'version') {
    writeLine(VERSION);
    return;
  }
  if (cmd === undefined || cmd === '-h' || cmd === '--help' || cmd === 'help') {
    usage();
    return;
  }

  config();
  const { flags, rest } = parseFlags(args);

  if (cmd === 'http') {
    const port = Number(rest[0]);
    if (!Number.isInteger(port) || port < 1 || port > 65535) die('usage: vps http <port>');
    const route = await addHttp(port, flags);
    if (flags.detach) return;
    writeLine('\npress ctrl-c to close');
    tailRequests(route.name);
    keepAlive();
    return;
  }

  if (cmd === 'tcp') {
    const port = Number(rest[0]);
    if (!Number.isInteger(port) || port < 1 || port > 65535) die('usage: vps tcp <port>');
    await addTcp(port, flags);
    if (flags.detach) return;
    writeLine('\npress ctrl-c to close');
    keepAlive();
    return;
  }

  switch (cmd) {
    case 'ls':
    case 'list': return cmdLs();
    case 'rm':
    case 'remove': return cmdRm(rest);
    case 'clean': return cmdClean();
    case 'open': return cmdOpen(rest);
    case 'doctor': return cmdDoctor();
    default: die(`unknown command "${cmd}". run: vps --help`);
  }
}

main().catch((e) => die(e.stack || e.message));
